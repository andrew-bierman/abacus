      "type": "array"
    },
    "reason": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "self_dependencies": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "setup": {
      "$ref": "#/$defs/Guide"
    },
    "source": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "unblocks": {
      "type": "integer"
    }
