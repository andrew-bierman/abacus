          "type": "integer"
        },
        "blocks": {
          "type": "integer"
        },
        "bottleneck": {
          "type": "boolean"
        },
        "focus": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "in_cycle": {
          "type": "boolean"
        },
        "layer": {
          "type": "integer"
        },
