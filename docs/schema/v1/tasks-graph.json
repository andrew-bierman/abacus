          },
          "type": "array"
        },
        "on_chain": {
          "type": "boolean"
        },
        "order": {
          "type": "integer"
        },
        "priority": {
          "type": "integer"
        },
        "ready": {
          "type": "boolean"
        },
        "self_dependency": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "layer",
        "order",
        "priority",
        "status",
        "title"
      ],
      "type": "object"
    },
    "Guide": {
      "properties": {
        "action": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
