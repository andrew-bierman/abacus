{
  "$defs": {
    "Guide": {
      "properties": {
        "action": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "domain",
        "message",
        "step"
      ],
      "type": "object"
    },
    "TaskCommentView": {
