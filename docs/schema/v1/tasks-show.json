          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "TaskRef": {
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
