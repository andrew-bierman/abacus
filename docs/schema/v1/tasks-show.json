  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The --json output of: tasks show",
  "properties": {
    "acceptance": {
      "type": "string"
    },
    "blocked_by": {
      "items": {
        "$ref": "#/$defs/TaskRef"
      },
      "type": "array"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/TaskRef"
      },
      "type": "array"
    },
    "children": {
      "items": {
        "$ref": "#/$defs/TaskRef"
      },
      "type": "array"
    },
    "close_reason": {
      "type": "string"
    },
    "closed_at": {
      "type": "string"
    },
    "comments": {
      "items": {
        "$ref": "#/$defs/TaskCommentView"
      },
      "type": "array"
    },
    "demo": {
      "description": "true when every value is invented fixture data (--demo, ABACUS_DEMO=1); omitted otherwise",
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "design": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "how_to_connect": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "parent": {
      "$ref": "#/$defs/TaskRef"
    },
    "reason": {
      "type": "string"
    },
    "row": {
      "$ref": "#/$defs/TaskRow"
    },
    "schema_version": {
      "const": 1
    },
    "setup": {
      "$ref": "#/$defs/Guide"
    },
    "source": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "domain",
    "row",
    "schema_version",
    "state",
    "title"
  ],
  "title": "tasks-show",
  "type": "object",
  "x-abacus-schema": 1
}
