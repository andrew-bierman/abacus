          "type": "string"
        },
        "blocked": {
          "type": "boolean"
        },
        "blocked_by": {
          "type": "integer"
        },
        "blocks": {
          "type": "integer"
        },
        "child_done": {
          "type": "integer"
        },
        "child_total": {
          "type": "integer"
        },
        "comments": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "defer_until": {
          "type": "string"
        },
        "held_by": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "parent": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "ready": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "priority",
        "status",
        "title"
      ],
      "type": "object"
    }
