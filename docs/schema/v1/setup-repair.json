          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "applied",
        "step"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
