      "type": "string"
    },
    "agent_command": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "board_url": {
      "type": "string"
    },
    "lambe_config": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "search_history": {
      "type": "string"
    },
    "tracker_dir": {
      "type": "string"
    }
