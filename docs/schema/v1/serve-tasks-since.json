{
  "$defs": {
    "TaskRow": {
      "properties": {
        "age": {
          "type": "string"
        },
        "assignee": {
          "type": "string"
        },
        "blocked": {
          "type": "boolean"
        },
        "blocked_by": {
          "type": "integer"
        },
        "blocks": {
          "type": "integer"
        },
        "child_done": {
          "type": "integer"
        },
        "child_total": {
          "type": "integer"
        },
        "comments": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "defer_until": {
          "type": "string"
        },
        "held_by": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "parent": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "ready": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "priority",
        "status",
        "title"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The --json output of: serve tasks.since",
  "properties": {
    "demo": {
      "description": "true when every value is invented fixture data (--demo, ABACUS_DEMO=1); omitted otherwise",
      "type": "boolean"
    },
    "fingerprint": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "delta",
        "full"
      ],
      "type": "string"
    },
    "read_at": {
      "type": "string"
    },
    "removed": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/TaskRow"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "total": {
      "type": "integer"
    },
    "tracker": {
      "type": "string"
    }
  },
  "required": [
    "fingerprint",
    "kind",
    "removed",
    "rows",
    "schema_version",
    "total"
  ],
  "title": "serve-tasks-since",
  "type": "object",
  "x-abacus-schema": 1
}
